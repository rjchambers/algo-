# Copy to .env and fill in. NEVER commit .env.
#
# Environment selector: "testnet" (default) or "mainnet".
HL_TRADER_NETWORK=testnet

# Hyperliquid AGENT (API) wallet private key. Phase 3+ only; leave empty for
# read-only Phases 0-2. This must be an agent wallet key created via the
# Hyperliquid UI/API — an agent wallet CANNOT withdraw funds.
# NEVER put your master/withdrawal wallet key here.
HL_TRADER_AGENT_PRIVATE_KEY=

# The account address the agent trades on behalf of (your main address).
HL_TRADER_ACCOUNT_ADDRESS=

# Where on-disk market-data caches are written (parquet).
HL_TRADER_DATA_CACHE_DIR=data_cache

# Logging
HL_TRADER_LOG_LEVEL=INFO
HL_TRADER_LOG_DIR=logs
